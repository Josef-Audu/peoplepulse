# PeoplePulse environment — variable NAMES only. No real credentials here.
# Copy to .env.local for local development. .env.local is git-ignored (see .gitignore).
#
# Phase 0A: values not required — the scaffold runs without Supabase configured.
# Phase 1 will wire these via @supabase/ssr (browser/server clients).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Must never be exposed to client components:
# no NEXT_PUBLIC_ prefix, never imported in "use client" modules,
# only referenced in server actions / route handlers / server components.
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (single session system for the demo)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
